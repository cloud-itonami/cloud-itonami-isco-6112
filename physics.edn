;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": a field robot performs sowing, weeding,
;; irrigation-check and targeted harvest support for market gardeners
;; (ISCO 6112). Its physical work here: checking that the irrigation header
;; delivers a bed's flow without too much pressure loss, and carrying picked
;; produce crates along the garden path to the packing shed.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-6112"
 :cases
 [{:id :irrigation-header-check
   :kind :pipe-flow
   :procedure "irrigation check: friction head lost along an 80 m, 25 mm polyethylene header feeding a bed's drip laterals"
   :params {:diameter-m 0.025 :length-m 80.0 :roughness-m 7.0e-6
            :density-kg-m3 998.0 :viscosity-pa-s 1.0e-3 :pump-efficiency 0.55 :elevation-m 1.0}
   :sweep {:param :q-m3s :values [0.0002 0.0005 0.0008 0.0012 0.0016 0.002]}
   :quantity :head-m
   :limit {:max 10.0 :basis "estimate: a small market-garden drip system runs on about 1 bar, so the header may not consume more than ~10 m of head"}
   :boundary {:lo 0.0001 :hi 0.004}}
  {:id :produce-crate-to-packing-shed
   :kind :transport
   :procedure "field robot carries picked produce crates 60 m along the garden path to the packing shed"
   :params {:mass-kg 80.0 :distance-m 60.0 :v-max-mps 0.8 :a-max-mps2 0.3
            :brake-decel-mps2 0.6 :drive-force-n 180.0 :crr 0.06
            :cog-height-m 0.50 :support-half-length-m 0.35}
   :sweep {:param :payload-kg :values [10.0 30.0 60.0 90.0 120.0]}
   :quantity :cycle-time-s
   :limit {:max 120.0 :basis "estimate: one crate run within 2 minutes keeps leafy produce out of the sun"}
   :boundary {:lo 5.0 :hi 250.0}}]}
